<?xml version="1.0" encoding="utf-8"?>
<!-- Impide que copias de seguridad automáticas extraigan la base de datos
     cifrada o las preferencias con las credenciales. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
